# App
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payzeph

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Flutterwave (required — get keys from https://app.flutterwave.com/dashboard/settings/apis)
FLW_SECRET_KEY=FLWSECK_TEST-xxxxx
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLW_WEBHOOK_HASH=

# VTPass (optional — bills work in simulation mode without these)
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# Frontend URL (for Paystack callback)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@payzeph.com

# Sentry
SENTRY_DSN=
